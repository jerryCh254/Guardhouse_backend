{
	"info": {
		"_postman_id": "guardhouse-api-collection",
		"name": "Guardhouse Backend - Complete API Collection",
		"description": "Complete API collection with request bodies and response examples for all Guardhouse Backend APIs. Base URL: http://localhost:8080 (or set in env). Use Login/Auth to get token, then set collection variable `token`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "baseUrl", "value": "http://localhost:8080"},
		{"key": "token", "value": ""}
	],
	"item": [
		{
			"name": "Auth",
			"description": "User auth: signup, login, forget/reset password, logout, get users.",
			"item": [
				{
					"name": "Signup",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\",\n  \"phone\": \"+1234567890\",\n  \"companyId\": \"\",\n  \"createdBy\": \"\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/signup",
						"description": "**Body (required):** name, email, password, role. Optional: phone, companyId, createdBy.\n\n**Response 201:**\n```json\n{\n  \"message\": \"User registered successfully\",\n  \"user\": { \"_id\", \"name\", \"email\", \"role\", \"phone\", \"companyId\" }\n}\n```"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login",
						"description": "**Body:** email, password. Save the returned `token` into collection variable `token` for other requests.\n\n**Response 200:**\n```json\n{\n  \"message\": \"Login successful\",\n  \"token\": \"eyJhbGc...\",\n  \"id\": \"...\",\n  \"email\": \"user@example.com\",\n  \"name\": \"John Doe\"\n}\n```"
					}
				},
				{
					"name": "Forget Password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}"},
						"url": "{{baseUrl}}/api/auth/forgetpassword",
						"description": "**Body:** email.\n\n**Response 200:** { \"message\": \"Reset link sent to email\" }"
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"reset_token_from_email_link\",\n  \"password\": \"newPassword123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/resetpassword",
						"description": "**Body:** token (from email link), password (new).\n\n**Response 200:** { \"message\": \"Password reset successfully\" }"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"url": "{{baseUrl}}/api/auth/logout",
						"description": "**Response 200:** { \"message\": \"Logged out successfully\" }"
					}
				},
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/auth/getAllUsers",
						"description": "**Response 200:** { \"message\": \"...\", \"users\": [...] }"
					}
				}
			]
		},
		{
			"name": "Company",
			"description": "Company register/login, SuperAdmin company status, Holidays, Skills, Compliance, Role Templates, Documents, Data Import, Site Positions.",
