	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Signup",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\",\n  \"phone\": \"+1234567890\",\n  \"companyId\": \"\",\n  \"createdBy\": \"\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/signup",
						"description": "**Body (required):** name, email, password, role, phone. Optional: companyId, createdBy.\n\n**Response 201:** { message, user: { id, name, email, role, phone, companyId, createdBy } }"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login",
						"description": "**Body:** email, password.\n\n**Response 200:** { message, token, id, email, name } — Save token for Authorization header."
					}
				},
				{
					"name": "Forget Password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}"},
						"url": "{{baseUrl}}/api/auth/forgetpassword"
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"reset_token_from_email_link\",\n  \"password\": \"newPassword123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/resetpassword"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"url": "{{baseUrl}}/api/auth/logout"
					}
				},
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/auth/getAllUsers",
						"description": "**Response 200:** { message, users }"
					}
				}
			]
		},
