					"name": "Company Forget Password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\n  \"companyEmail\": \"company@example.com\"\n}"},
						"url": "{{baseUrl}}/api/company/forgetpassword",
						"description": "**Response 200:** { \"message\": \"Reset link sent\" }"
					}
				},
