						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"companyName\": \"Acme Ltd\",\n  \"companyEmail\": \"company@example.com\",\n  \"ContactInfo\": \"+1234567890\",\n  \"address\": \"123 Business St\",\n  \"registrationNumber\": \"REG123\",\n  \"plan\": \"premium\"\n}"
						},
						"url": "{{baseUrl}}/api/company/register",
						"description": "**Body (required):** companyName, companyEmail, ContactInfo, address, registrationNumber, plan.\n\n**Response 201:** { \"message\", \"data\", \"status\" }"
					}
				},
				{
					"name": "Company Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"companyEmail\": \"company@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": "{{baseUrl}}/api/company/login",
						"description": "**Body:** companyEmail, password.\n\n**Response 200:** { \"message\", \"token\", \"id\", \"companyEmail\", \"companyName\" }"
					}
				},
